{
  "name": "inventoryapi",
  "version": "1.0.0",
  "description": "Inventory-API",
  "author": "Ponnar V",
  "license": "MIT",
  "scripts": {
    "tsc": "tsc",
    "watch-tsc": "tsc -w",
    "server": "concurrently --handle-input \"npm run watch-tsc\" \"npm run watch-deploy\"",
    "start": "nodemon --config nodemon.json src/server.ts",
    "dev": "nodemon --config nodemon.json src/server.ts",
    "build": "rimraf dist && concurrently --handle-input \" npm run tsc\" ",
    "deploy": "node dist/src/server.js",
    "watch-deploy": "nodemon dist/src/server.js",
    "start:dev": "rimraf dist && concurrently --handle-input \"tsc -w -p tsconfig.json\" \"wait-on dist/server.js && nodemon dist/server.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.14.1",
    "concurrently": "^9.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-openid-connect": "^2.17.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.5.0",
    "js-base64": "^3.7.8",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.11",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/mqtt": "^2.5.0",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^7.0.4",
    "ts-node": "^10.9.2"
  }
}
