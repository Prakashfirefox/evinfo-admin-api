// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 3. USERS
model Users {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  password       String
  last_login     DateTime?
  is_superuser   Boolean   @default(false)
  user_name      String    @unique
  first_name     String?
  last_name      String?
  is_admin       Boolean   @default(false)
  is_active      Boolean   @default(true)
  date_joined    DateTime?
  dob            String?
  email          String    @unique
  country_code   String?
  designation    String?
  employee_id    String?
  gender         String?
  phone_no       String?
  full_name      String?
  org_name       String?
  approvals_id   String?
  otp            String?   @default("")
  otp_verified   Boolean   @default(false)
  email_verified Boolean   @default(false)
  refresh_token  String?
  last_logout    DateTime?
  is_deleted     Boolean   @default(false)
  role           String?
  created_by     String?
  updated_by     String?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())
  status         String?   @default("new")

  // Relation (virtual for MongoDB)
  blogs Blog[] @relation("UserBlogs")

  @@map("users")
}

model Blog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Basic
  title       String
  slug        String   @unique
  excerpt     String?
  cover_images String[]

  // Author (embedded)
  author_id   String?

  // Categorization
  categories Categories[] @default([evs])
  tags       String[]

  // Blog Sections (embedded array)
  sections BlogSection[]

  // SEO (embedded)
  seo BlogSEO?

  // Status
  status    BlogStatus @default(draft)
  featured  Boolean    @default(false)
  view_count Int        @default(0)

  // Publishing
  published   Boolean   @default(false)
  published_at DateTime?

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?
  is_deleted Boolean @default(false)

  // virtual relation (no foreign keys in MongoDB)
  user Users? @relation("UserBlogs", fields: [author_id], references: [id])

  @@map("blogs")
}

enum Categories {
  evs
  AutoMoobiles
  Technology
  Lifestyle
  Business
  Health
  Travel
  Education
  Entertainment
  Food
  Fashion
  Sports
}

enum BlogStatus {
  draft
  published
  archived
}

type BlogSection {
  heading String?
  content String?
  images  String[]
  order   Int?
}

type BlogSEO {
  metaTitle       String?
  metaDescription String?
  keywords        String[]
}

model Banner {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId

  title        String
  slug         String   @unique
  image_url    String
  redirect_url String?
  position     String?   // HOME_TOP, HOME_MIDDLE, POPUP, etc
  priority     Int       @default(0)

  status       String    @default("active") // active | inactive

  start_date   DateTime?
  end_date     DateTime?

  is_deleted   Boolean   @default(false)

  created_by   String?   @db.ObjectId
  updated_by   String?   @db.ObjectId

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([start_date, end_date])
  @@index([is_deleted])
}
